# ==========================================
# Hey Jave Configuration
# ==========================================

# ── Google Cloud / Vertex AI Mode ─────────
# When GOOGLE_GENAI_USE_VERTEXAI is true, Google GenAI SDK automatically detects Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ── Google AI Studio / Gemini API Key Mode ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Python Backend Server ──────────────────
PYTHON_BACKEND_HOST=127.0.0.1
PYTHON_BACKEND_PORT=8765

# ── Windows UIA Automation ────────────────
UIA_TIMEOUT_MS=5000
SCREENSHOT_QUALITY=80
LOG_LEVEL=info
ENABLE_VISION_FALLBACK=true
